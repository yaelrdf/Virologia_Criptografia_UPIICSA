{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataDir": "data",
    "EncryptAtRest": false
  },
  "Jwt": {
    "Issuer": "signaltrace",
    "Audience": "signaltrace",
    "UserMinutes": 60,
    "DeviceDays": 30
  },
  "Auth": {
    "Pbkdf2Iterations": 600000
  },
  "Admin": {
    "Username": "admin"
  },
  "Server": {
    "SigningKeyPath": "server-signing-key.pem"
  },
  "Telemetry": {
    "MaxBodyBytes": 65536,
    "ReplayWindow": false,
    "SessionHours": 24
  },
  "Crypto": {
    "AllowChaCha": true
  },
  "Console": {
    "Enabled": true,
    "ExposePlaintext": true
  },
  "Lab": {
    "Enabled": true,
    "ExposeKeys": false,
    "EnableMitmDemo": true
  },
  "Mqtt": {
    "Enabled": false,
    "Port": 1883
  },
  "Alerts": {
    "WebhookUrl": "",
    "VibrationBandHz": [ 4.0, 6.0 ]
  },
  "Retention": {
    "Days": 30
  }
}
