digraph G { fontname="Arial"; node [fontname="Arial", fontsize=11]; edge [fontname="Arial", fontsize=10];
  rankdir=LR; node [shape=box, style="rounded,filled", fillcolor="#EEF4FB", color="#0F6CBD"];
  r [label="Lectura descifrada\ny validada", shape=oval, fillcolor="#DCEAF7"];
  ema [label="EMA (α = 0.3)\nRMS, RTT, RSSI"];
  z [label="z-score móvil\n(ventana 30)\nmarca |z| > 3", fillcolor="#FFF4E5", color="#9A6700"];
  ls [label="Mínimos cuadrados (5 min):\npendiente RSSI (dBm/min),\nbatería (%/h) y tiempo restante"];
  ft [label="DFT / FFT radix-2\n(64 muestras a 32 Hz)\nfrecuencia dominante"];
  db [label="SQLite\n(carga completa cifrable\nen reposo)", shape=cylinder];
  hub [label="SignalR → panel en vivo\ny gráficas del dashboard"];
  hist [label="Historial 15 min – 24 h\n(muestreo 1 de cada k)", fillcolor="#E6F4EA", color="#1A7F37"];
  grid [label="Malla regular +\ninterpolación lineal\n(huecos ≤ 5 intervalos)\n+ SMA/EMA", fillcolor="#E6F4EA", color="#1A7F37"];
  r -> {ema z ls ft}; {ema z ls ft} -> hub; r -> db; db -> hist; db -> grid; hist -> hub [style=dashed, label="REST"]; grid -> hub [style=dashed, label="REST"];
}
