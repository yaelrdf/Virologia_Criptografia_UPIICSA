<?xml version="1.0" encoding="utf-8"?>
<!--
  El servidor puede correr en la red local sin certificado (p. ej. http://dev-services.lan:5080),
  así que se permite HTTP sin cifrar hacia cualquier host. La app muestra un aviso cuando la URL
  es http:// y la guía de despliegue indica usar HTTPS en la nube.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
