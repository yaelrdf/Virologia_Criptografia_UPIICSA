digraph G { graph [fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.35, pad=0.2, bgcolor="white"];
node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef0ff", color="#4b3fd6", penwidth=1.2, margin="0.15,0.07"];
edge [fontname="DejaVu Sans", fontsize=9, color="#444444", arrowsize=0.7]; rankdir=LR;
  subgraph cluster_c { label="Clientes"; style="rounded,dashed"; color="#999999";
    web [label="Web responsiva\nHTML + CSS + JS"]; app [label="App Android\nKotlin + Compose"]; }
  subgraph cluster_s { label="Servidor (contenedor Docker)"; style="rounded,dashed"; color="#999999";
    api [label="ASP.NET Core 10 Web API\nauth · 2FA · stego · césar\ncomparador · admin"];
    core [label="Prisma.Core\nCésar · Esteganografía · ABCO\nmétricas"];
    db [label="SQLite\nusuarios · auditoría", shape=cylinder, style=filled, fillcolor="#f2f2f2", color="#666666"]; }
  web -> api [label="HTTPS + JWT", dir=both]; app -> api [label="HTTPS + JWT", dir=both];
  api -> core; api -> db;
}
