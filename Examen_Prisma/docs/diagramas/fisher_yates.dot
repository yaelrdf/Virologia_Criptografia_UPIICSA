digraph G { graph [fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.35, pad=0.2, bgcolor="white"];
node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef0ff", color="#4b3fd6", penwidth=1.2, margin="0.15,0.07"];
edge [fontname="DejaVu Sans", fontsize=9, color="#444444", arrowsize=0.7];
  ini [label="Inicio", shape=oval, style=filled, fillcolor="#d9f5ee", color="#1d8a6a"]; fin [label="Fin", shape=oval, style=filled, fillcolor="#d9f5ee", color="#1d8a6a"];
  ent [label="N canales, semilla", shape=parallelogram, style=filled, fillcolor="#fff4d6", color="#b07a00"]; l [label="L = [128, 129, …, N−1]"]; g [label="Generador LCG64:\nx = x·6364136223846793005 + 1442695040888963407 mod 2⁶⁴"];
  i [label="i = |L| − 1"]; u [label="v = 32 bits altos de x\nlímite = ⌊2³²/(i+1)⌋·(i+1)"]; q1 [label="¿v < límite?", shape=diamond, style=filled, fillcolor="#ffe3e8", color="#c4314b", margin="0.05,0.03"];
  j [label="j = v mod (i+1)"]; sw [label="Intercambiar L[i] y L[j]"]; dec [label="i = i − 1"]; q2 [label="¿i > 0?", shape=diamond, style=filled, fillcolor="#ffe3e8", color="#c4314b", margin="0.05,0.03"]; out [label="Recorrido R = L", shape=parallelogram, style=filled, fillcolor="#fff4d6", color="#b07a00"];
  ini -> ent -> l -> g -> i -> u -> q1; q1 -> u [label="no (rechazo)"]; q1 -> j [label="sí"]; j -> sw -> dec -> q2; q2 -> u [label="sí"]; q2 -> out [label="no"]; out -> fin;
}
