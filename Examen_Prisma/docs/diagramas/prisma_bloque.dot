digraph G { graph [fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.35, pad=0.2, bgcolor="white"];
node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef0ff", color="#4b3fd6", penwidth=1.2, margin="0.15,0.07"];
edge [fontname="DejaVu Sans", fontsize=9, color="#444444", arrowsize=0.7];
  ini [label="Inicio", shape=oval, style=filled, fillcolor="#d9f5ee", color="#1d8a6a"]; fin [label="Fin", shape=oval, style=filled, fillcolor="#d9f5ee", color="#1d8a6a"];
  ent [label="Mensaje P (bytes), claves", shape=parallelogram, style=filled, fillcolor="#fff4d6", color="#b07a00"]; pad [label="Si |P| es impar, agregar un 0"]; init [label="prev = C₀;  s = s₀"];
  blk [label="Tomar el siguiente bloque Pᵢ = (p₁, p₂)"]; s [label="1. César dinámico:  s = (a·s + c) mod 256"];
  x [label="2. Encadenamiento:  X = Pᵢ ⊕ prev"]; y [label="3. Hill:  Y = A·X mod 256"]; c [label="4. Desplazamiento:  Cᵢ = (Y + s) mod 256"];
  pr [label="Emitir Cᵢ;  prev = Cᵢ"]; q [label="¿Quedan bloques?", shape=diamond, style=filled, fillcolor="#ffe3e8", color="#c4314b", margin="0.05,0.03"]; out [label="Cifrado C", shape=parallelogram, style=filled, fillcolor="#fff4d6", color="#b07a00"];
  ini -> ent -> pad -> init -> blk -> s -> x -> y -> c -> pr -> q; q -> blk [label="sí"]; q -> out [label="no"]; out -> fin;
}
