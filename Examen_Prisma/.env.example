# ==========================================
# Configuración del servidor ABCO (Prisma)
# ==========================================

# Secreto JWT para firmar tokens (mínimo 32 caracteres aleatorios)
# Generar con: openssl rand -base64 48
JWT_KEY=

# Contraseña inicial para el usuario 'admin' (mínimo 8 caracteres)
ADMIN_PASSWORD=

# Nombre del usuario administrador inicial (opcional, por defecto 'admin')
ADMIN_USERNAME=admin

# Duración del token JWT en horas (opcional, por defecto 8)
JWT_HOURS=8

# Mostrar traza paso a paso en consola/admin (recomendado 'false' en producción)
DEMO_TRACE=false

# ==========================================
# Configuración de Cloudflare Tunnel
# ==========================================

# Token del túnel obtenido desde el dashboard de Cloudflare Zero Trust:
# Networks -> Tunnels -> Create a tunnel -> Docker
TUNNEL_TOKEN=
